{
  "openapi": "3.1.0",
  "info": {
    "title": "Wordweave HTTP API",
    "version": "1.0.0",
    "description": "同机 HTTP API。写入 JSON 必须为对象；未知字段、null 和多余内容被拒绝。PUT 为完整替换，PATCH 省略字段保留原值，空字符串清空文本。重复创建返回 409 与已有对象。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
