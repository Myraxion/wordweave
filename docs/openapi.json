  "components": {
    "schemas": {
      "Entry": {
        "type": "object",
        "required": [
          "id",
          "spelling",
          "definition",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "spelling": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Group": {
        "type": "object",
        "required": [
          "id",
          "type",
          "note",
          "createdAt",
          "updatedAt",
          "members"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          }
        }
      },
      "EntryInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "spelling": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        }
      },
      "GroupInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "memberIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "existingEntry": {
            "$ref": "#/components/schemas/Entry"
          },
          "existingGroup": {
            "$ref": "#/components/schemas/Group"
          }
        }
      }
    }
  }
}
